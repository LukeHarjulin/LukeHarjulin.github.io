flowchart LR
	Visitor["Website visitor"]:::actor

	subgraph PublicWeb["Public web boundary"]
		Pages["GitHub Pages<br>Astro listening page"]:::public
	end

	subgraph Cloudflare["Cloudflare account boundary"]
		Edge["Cloudflare DNS<br>spotify-api.lukeharjulin.com"]:::edge
		Cron["Cron Trigger<br>every 5 minutes"]:::schedule
		subgraph ServerSide["Server-side trust boundary"]
			Worker["Spotify listening-stats Worker<br>public API ingress; private secrets and execution"]:::private
			D1[("D1<br>spotify-listening")]:::data
		end
	end

	subgraph Spotify["Spotify service boundary"]
		SpotifyApi["Spotify Web API<br>current and recent playback"]:::external
		SpotifyAccounts["Spotify Accounts<br>token endpoint"]:::external
	end

	subgraph GitHub["GitHub boundary"]
		Actions["GitHub Actions<br>Astro build and Pages deploy"]:::delivery
	end

	Visitor -->|"loads /listening/"| Pages
	Pages -->|"public read-only HTTPS API"| Edge
	Edge --> Worker
	Cron -->|"scheduled event"| Worker
	Worker -->|"aggregate and bounded queries"| D1
	Worker -->|"refresh token exchange"| SpotifyAccounts
	Worker -->|"Bearer token requests"| SpotifyApi
	Actions -->|"deploys static dist"| Pages
	Actions -.->|"PUBLIC_SPOTIFY_API_BASE_URL"| Pages

